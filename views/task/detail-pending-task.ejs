<link rel="stylesheet" href="/css/taskCss/pendingDetail.css">

<div class="content">
    <div class="topOption">
        <div class="btn-option">
            <p>สร้างเมื่อวันที่ <span id="createAt">
                    <%= createdAt %>
                </span></p>
            <a href="/space/item/<%= spaceId %>/pedding" id="close_btn_link">
                <span id="close_btn">&times;</span>
            </a>
        </div>
    </div>

    <div class="taskSection">
        <div class="detail">
            <!-- Task Name -->
            <div class="firstSec">
                <div class="nameSec">
                    <h1 class="taskName" id="taskName-text">
                        <%= taskNames %>
                    </h1>
                </div>
            </div>
            <!-- Task Name -->

            <!-- Task Detail -->
            <div class="detailSec">
                <div class="detailHeader">
                    <div class="headerFirst">
                        <h1 class="detailText">รายละเอียด</h1>
                        <div class="task-summary hidden">
                            <p>สถานะ, ผู้รับผิดชอบ, ความสำคัญ, แท็กงาน, วันครบกำหนด, เวลาครบกำหนด</p>
                        </div>
                    </div>
                </div>
                <div class="grid-container">
                    <!-- status ✅ -->
                    <div class="grid-item topic status">
                        <div class="detail-name" id="status_dropdown">
                            <i class="fa-solid fa-circle-half-stroke"></i>
                            สถานะ
                        </div>
                        <div class="detail-data statusWrap" id="detail-data-status">
                            <div class="status-div" data-task-id="<%= task._id %>" data-status="<%= taskStatus %>">
                                <span class="status-icon"></span>
                                <span class="status-text">
                                    <%= taskStatus %>
                                </span>
                            </div>
                        </div>
                    </div>
                    <!-- status ✅ -->

                    <!-- assignedUsers -->
                    <div class="grid-item topic assignedUsers">
                        <div class="detail-name">
                            <i class="fa-regular fa-circle-user"></i>
                            ผู้รับผิดชอบ
                        </div>
                        <div class="detail-data" id="assignedDisplay">
                            <% if (assignedUsers.length> 0) { %>
                                <% assignedUsers.forEach(user=> { %>
                                    <div class="user-profile" style="position: relative;">
                                        <img src="<%= user.profileImage %>" alt="User Profile" width="40px"
                                            height="40px" style="border-radius: 50%; cursor: pointer;"
                                            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                        <div class="fallback-profile" style="display: none;">
                                            <span>
                                                <%= user.username[0] %>
                                            </span>
                                        </div>
                                        <span class="username-tooltip">
                                            <%= user.username %>
                                        </span>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <span>ไม่มีผู้รับผิดชอบ</span>
                                            <% } %>
                        </div>
                    </div>
                    <!-- assignedUsers -->

                    <!-- priority ✅ -->
                    <div class="grid-item topic priority">
                        <div class="detail-name" id="priority-dropdown">
                            <i class="fa-regular fa-flag"></i>
                            ความสำคัญ
                        </div>

                        <div class="detail-data priWrap" id="detail-data-priority">
                            <div class="priority-div" data-task-id="<%= task._id %>"
                                data-priority="<%= taskPriority %>">
                                <span class="priority-text"
                                    style="color: <%= priorityMapping[taskPriority].textColor %>;">
                                    <i class="fa <%= priorityMapping[taskPriority].icon %>" id="priIcon"></i>
                                    <%= priorityMapping[taskPriority].text %>
                                </span>
                            </div>
                        </div>
                    </div>
                    <!-- priority ✅ -->

                    <!-- Tags ✅ -->
                    <div class="grid-item topic tags">
                        <div class="detail-name">
                            <i class="fa-solid fa-tags"></i>
                            แท็กงาน
                        </div>
                        <div class="detail-data" id="tagsDisplay">
                            <div id="tagsDisplay">
                                <div class="visible-tags">
                                    <% if (taskTags.length> 0) { %>
                                        <% const visibleTags=taskTags.slice(0, 3); %>
                                            <% visibleTags.forEach(tag=> { %>
                                                <span class="tag-item" style="background-color: <%= tag.color %>;"
                                                    data-id="<%= tag._id %>">
                                                    <%= tag.tagName %>
                                                </span>
                                                <% }); %>
                                                    <% } else { %>
                                                        <span class="no-tags-message">ไม่มีแท็กงาน</span>
                                                        <% } %>
                                </div>
                                <div class="extra-tags" style="<%= taskTags.length > 3 ? '' : 'display: none;' %>">
                                    <% if (taskTags.length> 3) { %>
                                        <% const extraTagsCount=taskTags.length - 3; %>
                                            <span id="extraTagsIndicator">+<%= extraTagsCount %></span>
                                            <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Tags ✅ -->

                    <!-- dueDate ✅ -->
                    <div class="grid-item topic dueDate">
                        <div class="detail-name">
                            <i class="fa-regular fa-calendar-check"></i>
                            วันครบกำหนด
                        </div>
                        <form id="updateDueDateForm">
                            <div class="detail-data">
                                <%= formatDateToThai(dueDate) %>
                            </div>
                        </form>
                    </div>
                    <!-- dueDate ✅ -->

                    <!-- dueTime ✅ -->
                    <div class="grid-item topic dueTime">
                        <div class="detail-name">
                            <i class="fa-regular fa-clock"></i>
                            เวลาครบกำหนด
                        </div>
                        <div class="detail-data">
                            <form action="/updateDueTime" method="POST" id="updateDueTimeForm">
                                <div id="info">
                                    <div class="custom-select-container">
                                        <%=!dueTime ? 'ทั้งวัน' : '' %>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <!-- dueTime ✅ -->
                </div>
            </div>
            <!-- Task Detail -->

            <!-- Task Description -->
            <div class="descriptSec">
                <div class="description-box">
                    <div class="taskDescription-text">
                        <%= taskDetail || 'ไม่มีคำอธิบาย' %>
                    </div>
                </div>
            </div>
            <!-- Task Description -->
            </form>


            <div class="attachments-section">
                <h3><i class="fa-solid fa-paperclip" style="padding-right: 10px;"></i> ไฟล์ที่แนบมากับงาน </h3>
                <div class="fileItemSec">
                    <div class="fileItemSec">
                        <% if (attachments.length > 0) { %>
                            <ul id="fileItemlist">
                                <% attachments.forEach(attachment => { %>
                                    <li id="fileItem">
                                        <% const ext = attachment.originalName.split('.').pop().toLowerCase(); %>
                                        <div class="file-content">
                                            <a href="/uploads/<%= attachment.originalName %>" target="_blank" class="download-link" title="Preview">
                                                <% if (['jpg', 'jpeg', 'png'].includes(ext)) { %>
                                                    <!-- Show Image Preview -->
                                                    <img src="/uploads/<%= attachment.originalName %>" alt="<%= attachment.originalName %>" class="attachment-preview" />
                                                <% } else if (ext === 'pdf') { %>
                                                    <i class="fa-solid fa-file-pdf" style="color: #d9534f;"></i>
                                                    <% } else if (['doc', 'docx'].includes(ext)) { %>
                                                        <!-- Google Docs Preview -->
                                                        <i class="fa-solid fa-file-word" style="color: #337ab7;"></i>
                                                        <a href="https://docs.google.com/viewer?url=<%= encodeURIComponent('https://deploytest-8mln.onrender.com/uploads/' + attachment.originalName) %>" target="_blank" class="attachment-preview-link">
                                                            Open in Google Docs
                                                        </a>                                                        
                                                <% } else { %>
                                                    <i class="fa-solid fa-file" style="color: #6c757d;"></i>
                                                <% } %>
                                                <div class="fileName">
                                                    <span class="file-text">
                                                        <%= attachment.originalName %>
                                                    </span>
                                                </div>
                                            </a>
                                        </div>
                    
                                        <div class="fileWrap">
                                            <div class="file-time" data-uploaded="<%= attachment.uploadedAt %>">
                                                <span class="time-text">
                                                    อัปโหลดโดย: 
                                                    <img src="<%= attachment.uploadedByProfileImage %>" alt="Uploader's Profile Image" class="uploader-profile-img" />
                                                    <%= attachment.uploadedByName %> | <%= attachment.uploadedAtFormatted %>
                                                </span>
                                            </div>
                                            <!-- Add the download button -->
                                            <div class="file-item" data-file-id="<%= attachment._id %>">
                                                <a href="/uploads/<%= attachment.originalName %>" download="<%= attachment.originalName %>" class="download-icon-link">
                                                    <i class="fa-solid fa-download"></i> Download
                                                </a>
                                                <div class="deleteFile" data-id="<%= attachment._id %>">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } else { %>
                            <p id="noFile">ไม่มีไฟล์ที่อัปโหลด</p>
                        <% } %>
                    </div>
                                   
                </div>
            </div>

            <% if (subtasks.length > 0) { %>
                <div class="subtaskSec">
                    <h1 class="subText"><i class="fa-solid fa-list-check" style="padding-right: 10px;"></i> งานย่อย</h1>
                
                    <!-- Table for Subtasks (hidden initially if no data) -->
                    <div id="subtaskTableContainerNew" class="subtask-table">
                        <table id="subtaskTableNew">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>ชื่องานย่อย</th>
                                    <th>วันครบกำหนด</th>
                                    <th>สถานะ</th>
                                    <th>ผู้รับผิดชอบ</th>
                                </tr>
                            </thead>
                            <tbody id="subtaskTableBodyNew">
                                <% subtasks.forEach((subtask) => { %>
                                    <tr class="task-row" data-subtask-id="<%= subtask._id %>"
                                        style="opacity: <%= subtask.subTask_status === 'เสร็จสิ้น' ? '0.5' : '1' %>;"
                                        onclick="showSubtaskFullView('<%= subtask._id %>')">
                                        <td class="inputCheck">
                                            <input type="checkbox" class="checkbox" <%= subtask.subTask_status === 'เสร็จสิ้น' ? 'checked' : '' %>
                                            <%= subtask.assignee && String(subtask.assignee._id) === String(user._id) ? '' : 'disabled' %>
                                            onclick="event.stopPropagation()" />
                                        </td>
                                        <td><%= subtask.subtask_Name %></td>
                                        <td><%= subtask.subTask_dueDate %></td>
                                        <td>
                                            <div class="statusWrape"><%= subtask.subTask_status %></div>
                                        </td>
                                        <td>
                                            <% if (subtask.assignee) { %>
                                                <img src="<%= subtask.assignee.profileImage %>"
                                                    alt="<%= subtask.assignee.username %> Profile" class="user-avatar"
                                                    onerror="this.onerror=null; this.src='/public/img/profileImage/userDefalt.jpg';" />
                                                <%= subtask.assignee.username %>
                                            <% } else { %>
                                                <span>No Assignee</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <% } %>
                
            <!-- Subtask Full Page View -->
            <div class="full-subtask-page-view" id="fullPageViewSubtask" style="display: none;" data-subtask-id="">
                <div class="back-button">
                    <button onclick="closeSubtaskFullView()">
                        <i class="fa-solid fa-arrow-left"></i> กลับไปที่งาน
                    </button>
                    <button onclick="deleteSubtask()" class="deleteSub">
                        <i class="fa-solid fa-trash-can"></i> ลบงานย่อย
                    </button>
                </div>
                <div class="full-content">
                    <form id="updateSubtaskForm" action="/updateSubtask" method="POST">
                        <div class="nameSec">
                            <h1 class="SubtaskName" id="taskName-text">
                                <span id="subtaskNameText">subtask_Name</span>
                            </h1>
                            <input type="text" id="SubtaskName" name="SubtaskName" value="" style="display: none;"
                                onblur="saveSubTaskName()">
                        </div>
                        <div class="SubTaskdetailSec">
                            <div class="grid-container">
                                <div class="grid-item topic">
                                    <div class="sub-detail-name"><i class="fa-solid fa-circle-half-stroke"></i> สถานะ
                                    </div>
                                    <div class="detail-data">
                                        <button type="button" class="status-btn" id="subtaskStatusText"
                                            onclick="toggleStatus()">กำลังทำ</button>
                                    </div>
                                </div>
                                <div class="grid-item topic">
                                    <div class="sub-detail-name"><i class="fa-regular fa-calendar-check"></i>
                                        วันครบกำหนด</div>
                                    <div class="sub-detail-data" id="subtaskDueDateText">subTask_dueDate</div>
                                </div>
                                <div class="grid-item topic">
                                    <div class="sub-detail-name"><i class="fa-regular fa-circle-user"></i> ผู้รับผิดชอบ
                                    </div>
                                    <div class="sub-detail-data">
                                        <img src="<%= userImage %>"
                                            onerror="this.onerror=null; this.src='/public/img/profileImage/userDefalt.jpg';">
                                        <%= userName %>
                                    </div>
                                </div>
                            </div>
                            <div class="SubDescription-box">
                                <textarea name="subtaskDescription" id="subtaskDescription"
                                    placeholder="เพิ่มคำอธิบายของงานได้ที่นี่..."></textarea>
                            </div>
                            <input type="hidden" id="subtaskId" name="subtaskId" value="">
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="activitySection">
            <div class="approveSection">
                <div class="textTopic">
                    <h1>การอนุมัติ</h1>
                </div>

                <% if (task.taskStatus === 'pending') { %>
                    <!-- BEFORE APPROVAL -->
                    <div class="beforeApprove">
                      <div class="approveDetail">
                        <div class="approveButtonWrap" id="approvalSection" data-task-id="<%= taskId %>">
                          <button id="accept">
                            <i class="fa-regular fa-circle-check"></i> อนุมัติ
                          </button>
                          <button id="reject">
                            <i class="fa-regular fa-circle-xmark"></i> แก้ไข
                          </button>
                        </div>
                      </div>
                
                      <span class="approveText">
                        จำเป็นต้องได้รับการอนุมัติเพื่อทำให้งานเสร็จสิ้น หรืออาจถูกปฏิเสธเพื่อแก้ไขเพิ่มเติม
                      </span>
                
                      <div class="approversShow">
                        <% approvers.forEach(approver => { %>
                          <div class="approversItem">
                            <img src="<%= approver.profileImage %>" alt="Approver Image"
                              onerror="this.onerror=null; this.src='/public/img/profileImage/userDefalt.jpg';"
                              style="width: 40px; height: 40px; border-radius: 50%;">
                            <div class="approverDetails">
                              <span class="approversName"><%= approver.firstName %> <%= approver.lastName %></span>
                            </div>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  <% } 
                  
                  else { %>
                    <!-- AFTER APPROVAL -->
                    <div class="atferApprove">
                      <% if (task.taskStatus === 'finished') { %>
                        <span class="approveText" id="approveText">
                          งานถูกตรวจเรียบร้อย โดยงานของคุณเสร็จสิ้น<br>
                          ตรวจเมื่อวันที่ <%= formatDateToThai(task.approvedAt || task.updatedAt) %><br>
                          เวลา: <%= new Date(task.approvedAt).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', hour12: false }) %> น.
                        </span>
                      <% } else if (task.taskStatus === 'fix') { %>
                        <span class="approveText" id="rejectText">
                          งานถูกตรวจเรียบร้อย โดยมีการแก้ไข<br>
                          ตรวจเมื่อวันที่ <%= formatDateToThai(task.approvedAt || task.updatedAt) %><br>
                          เวลา: <%= new Date(task.approvedAt).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', hour12: false }) %> น.
                        </span>
                      <% } %>
                
                      <div class="afterApproversShow">
                        <span class="afterApproversShowText">ผู้อนุมัติ</span>
                        <% if (task.approvedBy) { %>
                          <div class="approversItem">
                            <img src="<%= task.approvedBy.profileImage || '/public/img/profileImage/userDefault.jpg' %>" 
                                 alt="Approver Image"
                                 onerror="this.onerror=null; this.src='/public/img/profileImage/userDefault.jpg';"
                                 style="width: 40px; height: 40px; border-radius: 50%;">
                            <div class="approverDetails">
                              <span class="approversName">
                                <%= task.approvedBy.firstName %> <%= task.approvedBy.lastName %>
                              </span>
                            </div>
                          </div>
                        <% } else { %>
                          <div class="approversItem">
                            <span class="approversName">ยังไม่มีผู้อนุมัติ</span>
                          </div>
                        <% } %>
                      </div>                      
                    </div>
                  <% } %>
                </div>

            <div class="activity">
                <div class="textTopic">
                    <h1>กิจกรรมที่เกิดขึ้น</h1>
                </div>
    
                <div class="messageAct">
                    <div class="activityUpdate">
                        <% task.activityLogs.forEach(log => { %>
                          <p class="log <%= log.type === 'comment' ? 'comment-log' : '' %>">
                            <%= log.text %>
                          </p>
                        <% }) %>
                    
                        <% task.comment.forEach(comment => { %>
                            <p class="log comment-log">
                                <img src="<%= comment.createdBy?.profileImage || '/public/img/profileImage/userDefault.jpg' %>" class="comment-user-img" alt="user" />
                                <strong><%= comment.createdBy?.firstName %> <%= comment.createdBy?.lastName %></strong>: <%= comment.text %>
                                <br><small><%= formatDateToThai(comment.createdAt) %></small>
                                <button class="delete-comment-btn" data-comment-id="<%= comment._id %>">Delete</button>
                    
                                <!-- Attachments Section -->
                                <% if (comment.attachments && comment.attachments.length > 0) { %>
                                    <div class="comment-attachments">
                                        <% comment.attachments.forEach(attachment => { %>
                                            <div class="attachment-item">
                                              <% const ext = attachment.originalName.split('.').pop().toLowerCase(); %>
                                              <a href="/<%= attachment.path %>" target="_blank" class="attachment-link" title="Preview">
                                                <% if (attachment.previewPath) { %>
                                                  <!-- Show Preview Image -->
                                                  <img src="/<%= attachment.previewPath %>" alt="Preview" class="attachment-preview" />
                                                <% } else if (['jpg', 'jpeg', 'png', 'gif'].includes(ext)) { %>
                                                  <!-- Show Image -->
                                                  <img src="/<%= attachment.path %>" alt="<%= attachment.originalName %>" class="attachment-preview" />
                                                <% } else { %>
                                                  <!-- Generic File Icon -->
                                                  <i class="fa-solid fa-file" style="font-size: 24px;"></i>
                                                  <span class="attachment-name"><%= attachment.originalName %></span>
                                                <% } %>
                                              </a>
                                              <a href="/<%= attachment.path %>" download="<%= attachment.originalName %>" class="download-link">
                                                <i class="fa-solid fa-download"></i> Download
                                              </a>
                                            </div>
                                          <% }) %>
                                    </div>
                                <% } %>
                            </p>
                        <% }) %>
                    </div>
                  </div>
                  
                  
    
                <!-- Comment Input Section -->
                <div class="commentSection">
                    <form id="addCommentForm" action="/task/<%= taskId %>/add-comment" method="POST">
                        <input type="text" id="commentInput" name="commentInput" placeholder="เพิ่มความคิดเห็น" class="form-control" required>
                        <div class="d-flex align-items-center">
                            <label for="commentFileUpload" class="btn btn-sm btn-light me-2">
                                <i class="fa-solid fa-paperclip"></i>
                                <input type="file" id="commentFileUpload" name="commentFileUpload" multiple
                                    accept=".jpg, .jpeg, .png, .pdf, .docx, .zip, .xls, .pptx, .raw" style="display:none;">
                            </label>
                          <button type="submit" class="btn btn-primary" id="sendComment" name="sendComment">
                            <i class="fa-regular fa-paper-plane"></i>
                          </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<body class="loading">
    <!-- The overlay div with white background -->
    <div class="overlay"></div>

    <!-- The spinner element -->
    <div class="loader"></div>

    <!-- Your page content goes here -->
    <div id="content">
        <!-- All other content for your page -->
    </div>

    <script src="script.js"></script>
</body>

<script>
    document.querySelectorAll('.delete-comment-btn').forEach(button => {
        button.addEventListener('click', (e) => {
          const commentId = e.target.dataset.commentId;
    
          if (confirm('Are you sure you want to delete this comment and all its attachments?')) {
            fetch(`/task/delete-comment/${commentId}`, {
              method: 'DELETE',
              headers: {
                'Content-Type': 'application/json'
              },
            })
              .then(response => {
                if (response.ok) {
                  alert('Comment and attachments deleted successfully.');
                  window.location.reload();
                } else {
                  return response.json().then(data => {
                    alert(`Error deleting comment: ${data.message}`);
                  });
                }
              })
              .catch(error => {
                console.error('Error:', error);
                alert('Error deleting comment.');
              });
          }
        });
      });
    

    document.getElementById('addCommentForm').addEventListener('submit', async function (e) {
        e.preventDefault();
    
        const commentInput = document.getElementById('commentInput').value.trim();
        if (!commentInput) {
            alert('Comment cannot be empty.');
            return;
        }
    
        const form = e.target;
        const formData = new FormData(form);
        formData.set('commentInput', commentInput); // Ensure text comment is always included
    
        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: formData // FormData automatically handles file uploads if present
            });
    
            const result = await response.json();
    
            if (result.success) {
                location.reload();
            } else {
                alert(result.message || 'Failed to add comment.');
            }
        } catch (error) {
            console.error('Error adding comment:', error);
            alert('An error occurred while adding the comment.');
        }
    });
    
    
    

    // Optional loader logic
    document.addEventListener('DOMContentLoaded', function () {
        function showLoader() {
            document.body.classList.add('loading');
        }

        function hideLoader() {
            document.body.classList.remove('loading');
            document.body.classList.add('loaded');
        }

        showLoader();

        window.addEventListener('load', function () {
            hideLoader();
        });

        setTimeout(() => hideLoader(), 3000);
    });

    document.addEventListener("DOMContentLoaded", () => {
        const approvalSection = document.getElementById("approvalSection");
        const taskId = approvalSection?.dataset.taskId;

        if (!taskId) return;

        const acceptBtn = document.getElementById("accept");
        const rejectBtn = document.getElementById("reject");

        let isProcessing = false;

        async function handleApproval(actionType) {
            if (isProcessing) return;
            isProcessing = true;

            try {
                const confirmMsg = actionType === 'approve'
                    ? "คุณแน่ใจหรือไม่ว่าต้องการอนุมัติงานนี้?"
                    : "คุณแน่ใจหรือไม่ว่าต้องการให้แก้งานนี้?";

                const confirmed = window.confirm(confirmMsg);
                if (!confirmed) {
                    isProcessing = false;
                    return;
                }

                // Show the overlay and spinner while waiting for the approval process
                showLoader();

                const response = await fetch(`/task/${taskId}/approval`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: actionType })
                });

                const data = await response.json();

                if (!response.ok) {
                    console.error('🔴 Server response error:', data);
                    throw new Error(data.message || 'เกิดข้อผิดพลาดในการอนุมัติ');
                }

                alert(data.message);
                window.location.reload(); // Reload the page after the approval action

            } catch (err) {
                console.error('🔴 Approval Error:', err);
                alert(err.message || 'เกิดข้อผิดพลาด');
            } finally {
                isProcessing = false;
                hideLoader(); // Hide the overlay and spinner once done
            }
        }

        acceptBtn?.addEventListener('click', () => handleApproval('approve'));
        rejectBtn?.addEventListener('click', () => handleApproval('reject'));
    });
</script>