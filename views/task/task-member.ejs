                                    </td>
                                    <td>
                                        <% if (collab.user._id.toString() !== user._id.toString() && currentUserRole === 'owner') { %>
                                            <button class="btn btn-danger btn-sm" onclick="deleteMember('<%= collab.user._id %>')" id="deleteBtn">ลบสมาชิก</button>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
