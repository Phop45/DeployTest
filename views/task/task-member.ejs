                                                <a class="dropdown-toggle" id="roleDropdown<%= collab._id %>" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <span class="roleDisplay <%= collab.role === 'owner' ? 'roleLeader' : collab.role === 'member' ? 'roleMember' : collab.role === 'guest' ? 'roleGuest' : collab.role === 'reporter' ? 'roleReporter' : '' %>"
                                                          id="selectedRoleDisplay<%= collab._id %>">
                                                        <%= collab.role === 'owner' ? 'เจ้าของ' : collab.role === 'member' ? 'สมาชิก' : collab.role === 'guest' ? 'ผู้เยี่ยมชม' : collab.role === 'reporter' ? 'ผู้ช่วย' : collab.role %>
                                                    </span>
                                                </a>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td>
