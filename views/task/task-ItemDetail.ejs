<div class="content">
    <div class="topOption">
        <div class="breadcomes">
            <a href="/project">โปรเจกต์ทั้งหมด</a>
            <span>/</span>
            <a href="/space/item/<%= spaceId %>">แดชบอร์ด</a>
            <span>/</span>
            <a href="/space/item/<%= spaceId %>/task_board">บอร์ดงาน</a>
            <span>/</span>
            <a class="active-detail">
                <%= taskNames %>
            </a>
        </div>
        <div class="btn-option">
            <p>สร้างเมื่อวันที่ <span id="createAt">
                    <%= createdAt %>
                </span></p>
            <a href="/space/item/<%= spaceId %>/task_board" id="close_btn_link">
                <span id="close_btn">&times;</span>
            </a>
        </div>
    </div>

    <div class="taskSection">
        <div class="detail">
            <!-- Task Name -->
            <div class="firstSec">
                <form id="updateName" method="POST" action="/updateName">
                    <input type="hidden" id="taskId" name="taskId" value="<%= task._id %>">
                    <div class="nameSec">
                        <h1 class="taskName" id="taskName-text">
                            <%= taskNames %>
                        </h1>
                        <input type="text" id="taskName" name="taskName" value="<%= taskNames %>" />
                        <span id="notiAlert" style="font-size: 14px; color: #FF004D; display: none; margin-top: 5px;">
                            * กรุณากรอกชื่อโดยไม่ใช้อักขระพิเศษ หรือค่าว่าง
                        </span>
                    </div>
                    <div class="btnOption">
                        <button type="submit" id="saveButton" style="display: none;">
                            <i class="fa-solid fa-check"></i>
                        </button>
                        <button type="button" id="cancelButton" style="display: none;">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </form>
                <% if (task.taskStatus === 'inProgress') { %>
                    <!-- Send button for active work -->
                    <div class="sendTask">
                        <button type="button" id="sendTask" onclick="checkWork('<%= taskId %>')">
                            <span>ส่งงาน</span>
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </div>
                <% } else if (task.taskStatus === 'fix') { %>
                    <div class="sendTask">
                        <button type="button" id="sendTask" onclick="checkWork('<%= taskId %>')">
                            <span>ส่งแก้ไข</span>
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </div>
                <% } %>
            </div>
            <!-- Task Name -->

            <!-- Task Detail -->
            <div class="detailSec">
                <div class="detailHeader">
                    <div class="headerFirst">
                        <h1 class="detailText">รายละเอียด</h1>
                        <div class="task-summary hidden">
                            <p>สถานะ, ผู้รับผิดชอบ, ความสำคัญ, แท็กงาน, วันครบกำหนด, เวลาครบกำหนด</p>
                        </div>
                    </div>

                    <span class="moreIcon">
                        <i class="fa-solid fa-chevron-up"></i>
                    </span>
                </div>
                <div class="grid-container">
                    <!-- status ✅ -->
                    <div class="grid-item topic status">
                        <div class="detail-name" id="status_dropdown">
                            <i class="fa-solid fa-circle-half-stroke"></i>
                            สถานะ
                        </div>
                        <div class="detail-data statusWrap" id="detail-data-status">
                            <div class="status-div" data-task-id="<%= task._id %>" data-status="<%= taskStatus %>">
                                <span class="status-icon"></span>
                                <span class="status-text">
                                    <%= taskStatus %>
                                </span>
                            </div>
                        </div>
                    </div>
                    <!-- status ✅ -->

                    <!-- assignedUsers -->
                    <div class="grid-item topic assignedUsers">
                        <div class="detail-name">
                            <i class="fa-regular fa-circle-user"></i>
                            ผู้รับผิดชอบ
                        </div>
                        <div class="detail-data" id="assignedDisplay" data-toggle="modal">
                            <% if (assignedUsers.length> 0) { %>
                                <% assignedUsers.forEach(user=> { %>
                                    <div class="user-profile" style="position: relative;">
                                        <img src="<%= user.profileImage %>" alt="User Profile" width="40px"
                                            height="40px" style="border-radius: 50%; cursor: pointer;"
                                            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                        <div class="fallback-profile" style="display: none;">
                                            <span>
                                                <%= user.username[0] %>
                                            </span>
                                        </div>
                                        <span class="username-tooltip">
                                            <%= user.username %>
                                        </span>
                                        <button class="remove-user-btn" data-user-id="<%= user._id %>"
                                            title="Remove User">
                                            <i class="fa-solid fa-xmark"
                                                style=" margin-top: 3px; margin-left: 1px;"></i>
                                        </button>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <span>ไม่มีผู้รับผิดชอบ</span>
                                            <% } %>

                                                <!-- Hidden modal initially -->
                                                <div id="assignedManagementModal" class="hidden">
                                                    <div class="modal-content">
                                                        <div class="modal-body">
                                                            <div id="task-id" data-task-id="<%= task._id %>"
                                                                style="display:none;"></div>
                                                            <div class="add-new-assigned">
                                                                <input type="text" id="searchAssigned"
                                                                    placeholder="ค้นหาสมาชิก" />
                                                            </div>
                                                            <div class="showAllAssigned" id="allAssignedContainer">
                                                                <% spaceUsers.forEach(user=> { %>
                                                                    <div class="assigned-item"
                                                                        data-user-id="<%= user._id %>">
                                                                        <img src="<%= user.profileImage %>"
                                                                            alt="<%= user.firstName %>" width="40px"
                                                                            height="40px" style="border-radius: 50%;"
                                                                            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                                                        <div class="fallback-profile-modal"
                                                                            style="display: none;">
                                                                            <span>
                                                                                <%= user.firstName[0] %>
                                                                            </span>
                                                                        </div>
                                                                        <div class="userInfo">
                                                                            <span id="assignedName">
                                                                                <%= user.username %>
                                                                            </span>
                                                                            <span id="assignedEmail">
                                                                                <%= user.googleEmail %>
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                    <% }) %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                        </div>
                    </div>
                    <!-- assignedUsers -->

                    <!-- priority ✅ -->
                    <div class="grid-item topic priority">
                        <div class="detail-name" id="priority-dropdown">
                            <i class="fa-regular fa-flag"></i>
                            ความสำคัญ
                        </div>

                        <div class="detail-data priWrap" id="detail-data-priority">
                            <div class="priority-div" data-task-id="<%= task._id %>"
                                data-priority="<%= taskPriority %>">
                                <span class="priority-text"
                                    style="color: <%= priorityMapping[taskPriority].textColor %>;">
                                    <i class="fa <%= priorityMapping[taskPriority].icon %>" id="priIcon"></i>
                                    <%= priorityMapping[taskPriority].text %>
                                </span>
                            </div>
                            <div class="dropdown-content" id="priority-dropdown-content" style="display: none;">
                                <a href="#" class="priority-option" data-priority="urgent">
                                    <i class="fa-solid fa-angles-up" id="priIcon"></i>
                                    ด่วน
                                </a>
                                <a href="#" class="priority-option" data-priority="normal">
                                    <i class="fa-solid fa-grip-lines" id="priIcon"></i>
                                    ปกติ
                                </a>
                                <a href="#" class="priority-option" data-priority="low">
                                    <i class="fa-solid fa-angle-down" id="priIcon"></i>
                                    ต่ำ
                                </a>
                            </div>
                        </div>
                    </div>
                    <!-- priority ✅ -->

                    <!-- Tags ✅ -->
                    <div class="grid-item topic tags">
                        <div class="detail-name">
                            <i class="fa-solid fa-tags"></i>
                            แท็กงาน
                        </div>
                        <div class="detail-data" id="tagsDisplay">
                            <div id="tagsDisplay">
                                <div class="visible-tags">
                                    <% if (taskTags.length> 0) { %>
                                        <% const visibleTags=taskTags.slice(0, 3); %>
                                            <% visibleTags.forEach(tag=> { %>
                                                <span class="tag-item" style="background-color: <%= tag.color %>;"
                                                    data-id="<%= tag._id %>">
                                                    <%= tag.tagName %>
                                                </span>
                                                <% }); %>
                                                    <% } else { %>
                                                        <span class="no-tags-message">ไม่มีแท็กงาน</span>
                                                        <% } %>
                                </div>
                                <div class="extra-tags" style="<%= taskTags.length > 3 ? '' : 'display: none;' %>">
                                    <% if (taskTags.length> 3) { %>
                                        <% const extraTagsCount=taskTags.length - 3; %>
                                            <span id="extraTagsIndicator">+<%= extraTagsCount %></span>
                                            <% } %>
                                </div>

                                <!-- Hidden modal initially -->
                                <div id="tagsManagementModal" class="hidden">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <div class="showTaskTags">
                                                <% if (taskTags.length> 0) { %>
                                                    <% taskTags.forEach(tag=> { %>
                                                        <span class="tag-item" id="visible-tags"
                                                            style="background-color: <%= tag.color %>;"
                                                            data-id="<%= tag._id %>">
                                                            <%= tag.tagName %>
                                                                <i class="fa-solid fa-xmark remove-tag"></i>
                                                        </span>
                                                        <% }); %>
                                                            <% } else { %>
                                                                <p style="margin-bottom: 0; padding-top: 10px; ">
                                                                    ไม่มีแท็กที่กำหนดให้กับงานนี้.</p>
                                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="modal-body">
                                            <div id="task-id" data-task-id="<%= task._id %>" style="display:none;">
                                            </div>
                                            <div class="add-new-tag">
                                                <input type="text" id="newTagInput"
                                                    placeholder="พิมพ์แท็กใหม่และกด Enter..." />
                                            </div>
                                            <div class="showAllTags" id="allTagsContainer">
                                                <% if (availableTags && availableTags.length> 0) { %>
                                                    <% availableTags.forEach(tag=> { %>
                                                        <span class="tag-item"
                                                            style="background-color: <%= tag.color %>;"
                                                            data-id="<%= tag._id %>"
                                                            data-tag-name="<%= tag.name.toLowerCase() %>">
                                                            <%= tag.name %>
                                                        </span>
                                                        <% }); %>
                                                            <% } else { %>
                                                                <p>No unassigned tags available.</p>
                                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Tags ✅ -->

                    <!-- dueDate ✅ -->
                    <div class="grid-item topic dueDate">
                        <div class="detail-name">
                            <i class="fa-regular fa-calendar-check"></i>
                            วันครบกำหนด
                        </div>
                        <form action="/updateDueDate" method="POST" id="updateDueDateForm">
                            <div class="detail-data clickable" id="dueDateText">
                                <%= dueDate ? new Date(dueDate).toLocaleDateString('th-TH', { day: 'numeric' ,
                                    month: 'long' , year: 'numeric' }) : 'ไม่มีวันครบกำหนด' %>
                            </div>
                            <input type="text" id="dueDateInput" name="dueDate"
                                value="<%= dueDate && !isNaN(new Date(dueDate).getTime()) ? 
                                           new Date(new Date(dueDate).getTime() - new Date(dueDate).getTimezoneOffset() * 60000).toISOString().split('T')[0] : '' %>"
                                class="flatpickr-input" style="visibility: hidden; position: absolute;">
                            <input type="hidden" name="taskId" value="<%= task._id %>">
                        </form>
                    </div>
                    <!-- dueDate ✅ -->

                    <!-- dueTime ✅ -->
                    <div class="grid-item topic dueTime">
                        <div class="detail-name">
                            <i class="fa-regular fa-clock"></i>
                            เวลาครบกำหนด
                        </div>
                        <div class="detail-data">
                            <form action="/updateDueTime" method="POST" id="updateDueTimeForm">
                                <div id="info">
                                    <div class="custom-select-container">
                                        <select id="dueTimeSelect" name="dueTime">
                                            <option value="" <%=!dueTime ? 'selected' : '' %>>ตลอดทั้งวัน</option>
                                            <% for (let hour=0; hour < 24; hour++) { let hourString=hour < 10 ? '0' +
                                                hour : hour; let isSelected00=dueTime===`${hourString}:00` ? 'selected'
                                                : '' ; let isSelected30=dueTime===`${hourString}:30` ? 'selected' : '' ;
                                                %>
                                                <option value="<%= hourString %>:00" <%=isSelected00 %>><%= hourString
                                                        %>:00</option>
                                                <option value="<%= hourString %>:30" <%=isSelected30 %>><%= hourString
                                                        %>:30</option>
                                                <% } %>
                                        </select>
                                    </div>
                                    <input type="hidden" name="taskId" value="<%= task._id %>">
                                </div>
                            </form>
                        </div>
                    </div>
                    <!-- dueTime ✅ -->
                </div>
            </div>
            <!-- Task Detail -->

            <!-- Task Description -->
            <div class="descriptSec">
                <div class="description-box">
                    <textarea name="taskDescription" id="taskDescription" placeholder="เพิ่มคำอธิบายของงานได้ที่นี่..."
                        data-task-id="<%= task._id %>"><%= task.taskDetail %></textarea>
                    <div class="expand-icon">
                        <i class="fa-solid fa-expand"></i>
                    </div>
                </div>
            </div>
            <!-- Task Description -->

            <div class="subtaskSec">
                <h1 class="subText"><i class="fa-solid fa-list-check" style="padding-right: 10px;"></i> งานย่อย</h1>

                <!-- Table for Subtasks (hidden initially if no data) -->
                <div id="subtaskTableContainerNew" class="subtask-table" style="display: none;">
                    <table id="subtaskTableNew">
                        <thead>
                            <tr>
                                <th></th>
                                <th>ชื่องานย่อย</th>
                                <th>วันครบกำหนด</th>
                                <th>สถานะ</th>
                                <th>ผู้รับผิดชอบ</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="subtaskTableBodyNew">
                            <% subtasks.forEach((subtask)=> { %>
                                <tr class="task-row" data-subtask-id="<%= subtask._id %>"
                                    style="opacity: <%= subtask.subTask_status === 'finished' ? '0.5' : '1' %>;">
                                    <td class="inputCheck">
                                        <% if (subtask.assignee && String(subtask.assignee._id) === String(user._id)) { %>
                                            <input type="checkbox" class="checkbox" 
                                                <%= subtask.subTask_status === 'finished' ? 'checked' : '' %>
                                                <%= subtask.subTask_status === 'finished' ? '' : '' %> 
                                                onclick="event.stopPropagation(); toggleSubtaskStatus('<%= subtask._id %>');" />
                                        <% } %>
                                    </td>                                    
                                    <td>
                                        <%= subtask.subtask_Name %>
                                    </td>
                                    <td>
                                        <%= subtask.subTask_dueDate %>
                                    </td>
                                    <td>
                                        <div class="statusWrape" style="background-color: <%= subtask.subTask_status === 'inProgress' ? '#6EACDA' : '#4caf50' %>;">
                                            <%= subtask.subTask_status === 'inProgress' ? 'กำลังทำ' : 'เสร็จสิ้น' %>
                                        </div>
                                    </td>
                                    <td>
                                        <% if (subtask.assignee) { %>
                                            <img src="<%= subtask.assignee.profileImage %>"
                                                alt="<%= subtask.assignee.username %> Profile" class="user-avatar"
                                                onerror="this.onerror=null; this.src='/public/img/profileImage/userDefalt.jpg';" />
                                            <%= subtask.assignee.username %>
                                                <% } else { %>
                                                    <span>No Assignee</span>
                                                    <% } %>
                                    </td>
                                    <td class="deleteSubtask" onclick="deleteSubtask('<%= subtask._id %>', this)">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Single Subtask Form -->
                <form action="/addSubtask" method="POST" id="subtaskFormMainNew" style="display: none;">
                    <input type="text" name="subTask" id="subtaskNameInputMainNew"
                        placeholder="เพิ่มงานย่อยที่คุณต้องการทำให้เสร็จสิ้นเลย" required />

                    <!-- Assignee Selection -->
                    <div class="assigneeInputNew" id="assigneeWrapper">
                        <div class="custom-dropdown" id="customDropdown">
                            <div class="dropdown-selected-assign" id="dropdownSelected_assign">
                                <span><i class="fa-solid fa-user"></i></span>
                            </div>
                            <div class="dropdown-assign" id="dropdownOptions">
                                <% assignedUsers.forEach(user=> { %>
                                    <div class="dropdown-option-assign" data-value="<%= user._id %>">
                                        <img src="<%= user.profileImage %>" alt="<%= user.username %> Profile"
                                            class="user-avatar"
                                            onerror="this.onerror=null; this.src='/public/img/profileImage/userDefalt.jpg';" />
                                        <span>
                                            <%= user.username %>
                                        </span>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>
                        <input type="hidden" id="assigneeSelect" name="assignee" required />
                    </div>


                    <!-- Due Date Input -->
                    <div class="dueDateInputNew" id="dueDateWrapper">
                        <i class="fa-regular fa-calendar-check" id="calendarIcon"></i>
                        <input type="date" name="dueDate" id="dueDateInputNew" required />
                    </div>

                    <button type="button" id="cancelSubtaskNew">ยกเลิก</button>
                    <button type="submit" id="addSubtaskNew">บันทึก</button>

                    <input type="hidden" name="taskId" id="taskId" value="<%= task._id %>" />
                </form>

                <!-- Add Subtask Button (Initially visible when there's no data) -->
                <button id="addSubtaskBtnMainNew" class="add-subtask-btn-detail">+ เพิ่มงานย่อยใหม่</button>
            </div>

            <div class="attachments-section">
                <h3><i class="fa-solid fa-paperclip" style="padding-right: 10px;"></i> แนบไฟล์</h3>
                <form action="/uploadDocument/<%= task._id %>/<%= spaceId %>" method="POST"
                    enctype="multipart/form-data" id="uploadInput">
                    <div class="attachment">
                        <div id="attach">
                            <label class="attachmentLabel" for="fileUpload">เลือกไฟล์</label>
                            <input type="file" id="fileUpload" name="taskAttachments" multiple
                                accept=".jpg, .jpeg, .png, .pdf, .docx, .zip, .xls, .pptx, .raw" />
                            <span id="fileName">ไม่ได้เลือกไฟล์ใด</span>
                        </div>
                        <button type="submit" class="btn btn-primary">อัพโหลด</button>
                    </div>
                    <p class="file_input_help"" id=" file_input_help">
                        jpg, jpeg, png, docx, doc, pdf (ไม่เกิน 5 MB).
                    </p>
                </form>

                <div class="fileItemSec">
                    <% if (attachments.length> 0) { %>
                        <ul id="fileItemlist">
                            <% task.attachments.forEach(attachment=> { %>
                                <li id="fileItem">
                                    <% const ext=attachment.originalName.split('.').pop().toLowerCase(); %>
                                        <div class="file-content">
                                            <a href="/uploads/<%= attachment.originalName %>"
                                                download="<%= attachment.originalName %>" class="download-link">
                                                <% if (ext==='pdf' ) { %>
                                                    <i class="fa-solid fa-file-pdf" style="color: #d9534f;"></i>
                                                    <% } else if (['doc', 'docx' ].includes(ext)) { %>
                                                        <i class="fa-solid fa-file-word" style="color: #337ab7;"></i>
                                                        <% } else if (['jpg', 'jpeg' , 'png' ].includes(ext)) { %>
                                                            <i class="fa-solid fa-file-image"
                                                                style="color: #5cb85c;"></i>
                                                            <% } else { %>
                                                                <i class="fa-solid fa-file" style="color: #6c757d;"></i>
                                                                <% } %>
                                                                    <div class="fileName">
                                                                        <span class="file-text">
                                                                            <%= attachment.originalName %>
                                                                        </span>
                                                                    </div>
                                            </a>
                                        </div>

                                        <div class="fileWrap">
                                            <div class="file-time" data-uploaded="<%= attachment.uploadedAt %>">
                                                <span class="time-text"></span>
                                            </div>
                                            <!-- Delete button with data-id for file reference -->
                                            <div class="file-item" data-file-id="<%= attachment._id %>">
                                                <!-- file info -->
                                                <div class="deleteFile" data-id="<%= attachment._id %>">
                                                  <i class="fa-solid fa-trash-can"></i>
                                                </div>
                                            </div>
                                        </div>

                                </li>
                                <% }) %>

                                    <% } else { %>
                                        <p id="noFile">ไม่มีไฟล์ที่อัปโหลด</p>
                                        <% } %>
                        </ul>
                </div>
            </div>

            <!-- Full detail Page View -->
            <div class="full-page-view" id="fullPageView">
                <div class="back-button">
                    <button>
                        <i class="fa-solid fa-arrow-left"></i>
                        กลับไปที่งาน
                    </button>
                </div>
                <div class="full-content">
                    <!-- Full content goes here -->
                    <h1 class="taskName" id="taskName-text">
                        <%= taskNames %>
                    </h1>
                    <textarea name="taskDescription" id="taskDescriptionFullView"
                        placeholder="เพิ่มคำอธิบายของงานได้ที่นี่..."
                        data-task-id="<%= task._id %>"><%= task.taskDetail %></textarea>
                </div>
            </div>


            <!-- Subtask Full Page View -->
            <div class="full-subtask-page-view" id="fullPageViewSubtask" style="display: none;" data-subtask-id="">
                <div class="back-button">
                    <button onclick="closeSubtaskFullView()">
                        <i class="fa-solid fa-arrow-left"></i> กลับไปที่งาน
                    </button>
                    <button onclick="deleteSubtask()" class="deleteSub">
                        <i class="fa-solid fa-trash-can"></i> ลบงานย่อย
                    </button>
                </div>
                <div class="full-content">
                    <form id="updateSubtaskForm" action="/updateSubtask" method="POST">
                        <div class="nameSec">
                            <h1 class="SubtaskName" id="taskName-text">
                                <span id="subtaskNameText">subtask_Name</span>
                            </h1>
                            <input type="text" id="SubtaskName" name="SubtaskName" value="" style="display: none;"
                                onblur="saveSubTaskName()">
                        </div>
                        <div class="SubTaskdetailSec">
                            <div class="grid-container">
                                <div class="grid-item topic">
                                    <div class="sub-detail-name"><i class="fa-solid fa-circle-half-stroke"></i> สถานะ
                                    </div>
                                    <div class="detail-data">
                                        <button type="button" class="status-btn" id="subtaskStatusText"
                                            onclick="toggleStatus()">กำลังทำ</button>
                                    </div>
                                </div>
                                <div class="grid-item topic">
                                    <div class="sub-detail-name"><i class="fa-regular fa-calendar-check"></i>
                                        วันครบกำหนด
                                    </div>
                                    <div class="sub-detail-data" id="subtaskDueDateText">subTask_dueDate</div>
                                </div>
                                <div class="grid-item topic">
                                    <div class="sub-detail-name"><i class="fa-regular fa-circle-user"></i> ผู้รับผิดชอบ
                                    </div>
                                    <div class="sub-detail-data">
                                        <img src="<%= userImage %>"
                                            onerror="this.onerror=null; this.src='/public/img/profileImage/userDefalt.jpg';">
                                        <%= userName %>
                                    </div>
                                </div>
                            </div>
                            <div class="SubDescription-box">
                                <textarea name="subtaskDescription" id="subtaskDescription"
                                    placeholder="เพิ่มคำอธิบายของงานได้ที่นี่..."></textarea>
                            </div>
                            <input type="hidden" id="subtaskId" name="subtaskId" value="">
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="mainActivity">
            <div class="textTopic">
                <h1>กิจกรรมที่เกิดขึ้น</h1>
                <button id="clearLogsButton" data-task-id="<%= task._id %>">เครียร์แจ้งเตือน</button>
            </div>

            <div class="messageAct">
                <div class="activityUpdate" id="activityUpdate">
                    <% task.comment.filter(comment => !comment.deleted).forEach(comment => { %>
                        <div class="comment-container">
                            <div class="comment-header">
                                <img
                                    src="<%= comment.createdBy?.profileImage || '/public/img/profileImage/userDefault.jpg' %>"
                                    class="comment-user-img"
                                    alt="user"
                                />
                                <div class="comment-user-info">
                                    <strong><%= comment.createdBy?.firstName %> <%= comment.createdBy?.lastName %></strong>
                                    <small class="comment-date"><%= formatDateToThai(comment.createdAt) %></small>
                                </div>
                                <button
                                    class="delete-comment-btn"
                                    data-comment-id="<%= comment._id %>"
                                    title="Delete Comment"
                                >
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                            <div class="comment-body">
                                <p class="comment-text">
                                    <span style="color: red;">ได้คอมเมนต์: </span><%= comment.text %></p>
                                <% if (comment.attachments && comment.attachments.length > 0) { %>
                                <div class="comment-attachments">
                                    <% comment.attachments.forEach(attachment => { %>
                                        <div class="attachment-item">
                                            <% const ext = attachment.originalName.split('.').pop().toLowerCase(); %>
                                            <% if (['jpg', 'jpeg', 'png', 'gif'].includes(ext)) { %>
                                            <!-- Image File -->
                                            <a
                                                href="/<%= attachment.path %>"
                                                target="_blank"
                                                class="attachment-link"
                                                title="<%= attachment.originalName %>"
                                            >
                                                <img
                                                    src="/<%= attachment.path %>"
                                                    alt="<%= attachment.originalName %>"
                                                    class="attachment-preview-large"
                                                />
                                            </a>
                                            <% } else { %>
                                            <!-- Non-Image File -->
                                            <a
                                                href="/<%= attachment.path %>"
                                                download="<%= attachment.originalName %>"
                                                class="attachment-link"
                                                title="<%= attachment.originalName %>"
                                            >
                                                <i class="fa-solid fa-file" style="font-size: 48px;"></i>
                                                <span class="attachment-name"><%= attachment.originalName %></span>
                                            </a>
                                            <% } %>
                                            <a
                                                href="/<%= attachment.path %>"
                                                download="<%= attachment.originalName %>"
                                                class="download-link"
                                                title="Download <%= attachment.originalName %>"
                                            >
                                                <i class="fa-solid fa-download"></i>
                                            </a>
                                        </div>
                                    <% }) %>
                                </div>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                    
                    <% task.activityLogs.filter(log => !log.deleted).forEach(log => {
                        const details = log.details || {};
                        const oldValue = details.oldValue || 'ไม่ทราบ';
                        const newValue = details.newValue || 'ไม่ทราบ';
                    
                        // Skip rendering if the fieldChanged is 'dueDate'
                        if (details.fieldChanged === 'dueDate') {
                            return; // Skip this log
                        }
                    %>
                        
                        <div class="log-entry">
                            <div class="log-entry-detail">
                                <!-- Display user profile image -->
                                <div class="user-profile-log">
                                    <% if (log.createdBy?.profileImage) { %>
                                        <img src="<%= log.createdBy.profileImage %>"
                                            alt="<%= log.createdBy.firstName %>"
                                            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                        <% } %>
                                            <div class="fallback-circle-activitylog"
                                                style="display: <%= log.createdBy?.profileImage ? 'none' : 'flex' %>;"">
                                                    <%= log.createdBy?.firstName?.charAt(0).toUpperCase() || '?' %>
                                                </div>
                                        </div>

                                        <!-- Log details -->
                                        <% if (details.fieldChanged === 'taskName') { %>
                                            <div class=" nameLog">
                                                <p id="logText">
                                                    <span id="whoChange">
                                                        <%= details.whoChange %>
                                                    </span> ได้อัพเดตชื่อของานใหม่
                                                </p>
                                                <div class="logDetail">
                                                    <span class="previous-name">"<%= oldValue %>"</span> เป็น
                                                    <span class="new-name">"<%= newValue %>"</span>
                                                </div>
                                            </div>
                                            <% } else if (details.fieldChanged==='status' ) { %>
                                                <div class="statusLog">
                                                    <p id="logText">
                                                        <span id="whoChange">
                                                            <%= details.whoChange %>
                                                        </span> ได้เปลี่ยนสถานะของงาน
                                                    </p>
                                                    <div class="logDetail">
                                                        <span class="previous-status"
                                                            data-status="<%= details.oldValue %>">
                                                            <%= statusMapping[details.oldValue] || details.oldValue %>
                                                        </span>
                                                        <i class="fa-solid fa-arrow-right toArrow"></i>
                                                        <span class="new-status" data-status="<%= details.newValue %>">
                                                            <%= statusMapping[details.newValue] || details.newValue %>
                                                        </span>
                                                    </div>
                                                </div>

                                                <% } else if (details.fieldChanged==='sendTask' ) { %>
                                                    <div class="statusLog">
                                                        <p id="logText_sendTask">
                                                            <span id="whoChange">
                                                                <%= details.whoChange %>
                                                            </span>
                                                        </p>
                                                    </div>

                                                <% } else if (details.fieldChanged==='priority' ) { %>
                                                    <div class="prorityLog">
                                                        <p id="logText">
                                                            <span id="whoChange">
                                                                <%= details.whoChange %>
                                                            </span> ได้เปลี่ยนความสำคัญของงาน
                                                        </p>
                                                        <div class="logDetail">
                                                            <span class="previous-priority"
                                                                data-priority="<%= oldValue %>"
                                                                style="color: <%= priorityMapping[oldValue] ? priorityMapping[oldValue].color : '#000000' %>;">
                                                                <i
                                                                    class="fa-solid logPriIcon <%= priorityMapping[oldValue] ? priorityMapping[oldValue].icon : '' %>"></i>
                                                                <%= priorityMapping[oldValue] ?
                                                                    priorityMapping[oldValue].text : oldValue %>
                                                            </span>
                                                            <i class="fa-solid fa-arrow-right toArrow"></i>
                                                            <span class="new-priority" data-priority="<%= newValue %>"
                                                                style="color: <%= priorityMapping[newValue] ? priorityMapping[newValue].color : '#000000' %>;">
                                                                <i
                                                                    class="fa-solid logPriIcon <%= priorityMapping[newValue] ? priorityMapping[newValue].icon : '' %>"></i>
                                                                <%= priorityMapping[newValue] ?
                                                                    priorityMapping[newValue].text : newValue %>
                                                            </span>
                                                        </div>
                                                    </div>

                                                    <% } else if (details.fieldChanged === 'dueDate') { %>
                                                        <div class="dueDateLog">
                                                            <p id="logText">
                                                                <span id="whoChange">
                                                                    <%= details.whoChange %>
                                                                </span> ได้เปลี่ยนวันครบกำหนดของงาน
                                                            </p>
                                                            <div class="logDetail">
                                                                <span class="previous-dueDate">
                                                                    <%= details.oldValue || 'ไม่มีวันครบกำหนด' %>
                                                                </span>
                                                                <i class="fa-solid fa-arrow-right toArrow"></i>
                                                                <span class="new-dueDate">
                                                                    <%= details.newValue || 'ไม่มีวันครบกำหนด' %>
                                                                </span>
                                                            </div>
                                                        </div>

                                                        <% } else if (details.fieldChanged==='dueTime' ) { %>
                                                            <div class="dueTimeLog">
                                                                <p id="logText">
                                                                    <span id="whoChange">
                                                                        <%= details.whoChange %>
                                                                    </span> ได้เปลี่ยนเวลาครบกำหนดของงาน
                                                                </p>
                                                                <div class="logDetail">
                                                                    <span class="previous-dueTime">
                                                                        <%= oldValue==='ตลอดทั้งวัน' ? oldValue :
                                                                            `${oldValue} น.` %>
                                                                    </span>
                                                                    เป็น
                                                                    <span class="new-dueTime">
                                                                        <%= newValue==='ตลอดทั้งวัน' ? newValue :
                                                                            `${newValue} น.` %>
                                                                    </span>
                                                                </div>
                                                            </div>
                                                            <% } else if (details.fieldChanged==='taskTags' ) { %>
                                                                <div class="dueTimeLog">
                                                                    <p id="logText">
                                                                        <span id="whoChange">
                                                                            <%= details.whoChange %>
                                                                        </span> ได้เพิ่มแท็กใหม่
                                                                    </p>
                                                                    <div class="logDetail">
                                                                        <span class="new-tags">
                                                                            <%= newValue %>
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                                <% } else if (details.fieldChanged==='tagsRemove' ) { %>
                                                                    <p id="dueTimeLog">
                                                                        <%= log.details.whoChange %> ได้ลบแท็กชื่อ:
                                                                            <span class="new-tags">
                                                                                <%= oldValue %>
                                                                            </span>
                                                                    </p>
                                                                    <% } else if (details.fieldChanged==='assignedUsers'
                                                                        ) { %>
                                                                        <div id="assignedLog">
                                                                            <%= log.details.whoChange %> ได้เพิ่มสมาชิก:
                                                                                <div class="assigned-member">
                                                                                    <% if (log.userId?.profileImage) {
                                                                                        %>
                                                                                        <img src="<%= log.userId.profileImage %>"
                                                                                            alt="<%= log.details.newValue %>"
                                                                                            width="40px" height="40px"
                                                                                            style="border-radius: 50%; margin-right: 8px;"
                                                                                            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                                                                        <% } %>
                                                                                            <div class="fallback-circle"
                                                                                                style="display: <%= log.userId?.profileImage ? 'none' : 'flex' %>;
                                                                width: 40px; height: 40px; 
                                                                border-radius: 50%; background-color: #ccc; 
                                                                align-items: center; justify-content: center; 
                                                                font-weight: bold; font-size: 16px; 
                                                                color: #fff; margin-right: 8px;">
                                                                                                <%= log.details.newValue?.charAt(0).toUpperCase()
                                                                                                    || '?' %>
                                                                                            </div>
                                                                                            <span
                                                                                                class="new-member-name">
                                                                                                <%= log.details.newValue
                                                                                                    %>
                                                                                            </span>
                                                                                </div>
                                                                        </div>
                                                                        <% } else if
                                                                            (details.fieldChanged==='removeAssignedUsers'
                                                                            ) { %>
                                                                            <div id="assignedLog">
                                                                                <%= log.details.whoChange %>
                                                                                    ได้ลบสมาชิก:
                                                                                    <div class="assigned-member">
                                                                                        <% if (log.userId?.profileImage)
                                                                                            { %>
                                                                                            <img src="<%= log.userId.profileImage %>"
                                                                                                alt="<%= log.details.oldValue %>"
                                                                                                width="40px"
                                                                                                height="40px"
                                                                                                style="border-radius: 50%; margin-right: 8px;"
                                                                                                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                                                                            <% } %>
                                                                                                <div class="fallback-circle"
                                                                                                    style="display: <%= log.userId?.profileImage ? 'none' : 'flex' %>;
                                                                width: 40px; height: 40px; 
                                                                border-radius: 50%; background-color: #ccc; 
                                                                align-items: center; justify-content: center; 
                                                                font-weight: bold; font-size: 16px; 
                                                                color: #fff; margin-right: 8px;">
                                                                                                    <%= log.details.oldValue?.charAt(0).toUpperCase()
                                                                                                        || '?' %>
                                                                                                </div>
                                                                                                <span
                                                                                                    class="new-member-name">
                                                                                                    <%= log.details.oldValue
                                                                                                        %>
                                                                                                </span>
                                                                                    </div>
                                                                            </div>
                                                                            <% } else { %>
                                                                                <p><%- log.text %></p>
                                                                                <% } %>
                                </div>
                                <p id="timeLog">
                                    <i class="fa-solid fa-clock-rotate-left"></i>
                                    เมื่อ: <%= new Date(log.createdAt).toLocaleString('th-TH', { month: 'long' ,
                                        day: 'numeric' , hour: '2-digit' , minute: '2-digit' }) %> น.
                                </p>
                            </div>
                            <% }) %>
                        </div>
                        
                </div>
            </div>
    </div>
</div>
