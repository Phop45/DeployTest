<div class="secside">
  <div class="sidebar close">
    <header class="headInfo">
      <div class="image-text">
        <span class="image">
          <img src="<%= user.profileImage %>" class="profileImage" alt="<%= user.username %>'s Profile Image"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
          <div class="fallback-profile-sideNav" style="display: none;">
            <span>
              <%= user.firstName[0] %>
            </span>
          </div>
        </span>
        <div class="text header-text">
          <span class="name">
            <%= user.firstName %>
          </span>
          <span class="user_id">
            <%= user.googleEmail %>
          </span>
        </div>
      </div>
      <div class="arrow-close" id="arrow-btn">
        <i class="bx bx-chevron-right toggle"></i>
      </div>
    </header>
    <div class="line"></div>
    <div class="menu-bar">
      <ul class="menu-link">
        <li class="nav-links">
          <a href="/dashboard">
            <i class="fa-solid fa-house" id="icon"></i>
            <span class="text navbar-text">หน้าหลัก</span>
          </a>
        </li>

        <li class="nav-links">
          <a href="/project">
            <i class="bx bx-columns" id="icon"></i>
            <span class="text navbar-text">โปรเกจต์ทั้งหมด</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="line"></div>
    <div class="showspace">
      <div class="space">
        <div class="spacoption">
          <span class="space-text" style="color: #656f7d">โปรเจกต์ทั้งหมด</span>
        </div>
        <div class="spaceitem-all">
          <div class="scollitem">
            <% if (spaces && spaces.length > 0) { %>
              <% spaces.forEach(function(space) { %>
                <ul class="spaceitem" data-link="/space/item/<%= space._id %>/dashboard?period=7day">
                  <li class="itemDetail">
                    <div class="spaceicon">
                      <span id="spaceicon">
                        <%= space?.projectName ? space.projectName.charAt(0) : 'N/A' %>
                      </span>
                      <span id="spacename">
                        <%= space.projectName %>
                      </span>
                    </div>
                  </li>
                </ul>
              <% }); %>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/script/navigation/sideNav.js"></script>
<script src="/script/navigation/nav_menu.js"></script>