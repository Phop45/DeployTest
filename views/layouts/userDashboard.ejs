<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>แดชบอร์ดสรุปงาน</title>

    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/date-fns@2.26.0/date-fns.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@sgratzl/chartjs-chart-timeline"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/date-fns/2.25.0/date-fns.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/th.js"></script>

  <!-- FullCalendar -->
  <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/partialsCss/sideNav.css" />
    <link rel="stylesheet" href="/css/partialsCss/topNavigation.css" />
    <link rel="stylesheet" href="/css/dashboardCss/dashboard.css" />
</head>
<body>
    <%- include('../partials/topNavigation.ejs') %>
    <%- include('../partials/sideNavigation.ejs') %>

    <div class="contentWarp">
        <div class="topSection">
            <div class="uesrProfile">
                <img src="<%= user.profileImage %>" 
                        class="profileImage" 
                        alt="<%= user.username %>'s Profile Image" 
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                <div class="fallback-profile" style="display: none;">
                    <span>
                        <%= user.firstName[0] %>
                    </span>
                </div>
            </div>
            <div class="welcomeText">
                <h1 class="wel">
                    <i class="<%= greetingIcon %>"></i>
                    <%= greeting %>, 
                    <%= user.firstName %>
                </h1>
                <p class="dateText">
                    <i class="fa-regular fa-calendar"></i>
                    <%= dateText %>
                </p>
            </div>
        </div>

        <div class="middleSection">
            <div class="leftSide">
                <div class="leftTop">
                    <div class="taskCard">
                        <div class="headerText">
                            <div class="titleCardText">
                                <i class="fa-regular fa-circle-check titleIcon"></i>
                                ความคืบหน้างานทั้งหมดของคุณ
                            </div>
                            <div class="subText">
                                แสดงภาพรวมของงานของคุณ
                            </div>
                        </div>
                        <div class="progressBarContainer">
                            <div class="progressBar" id="allTaskProgress">
                                <div class="progressBar toDo"
                                    style="width: <%= allTaskCount > 0 ? (statusCounts.pending / allTaskCount) * 100 : 0 %>%;"
                                    title="To Do (<%= statusCounts.pending %>)"></div>
                                <div class="progressBar inProgress"
                                    style="width: <%= allTaskCount > 0 ? (statusCounts.inProgress / allTaskCount) * 100 : 0 %>%;"
                                    title="In Progress (<%= statusCounts.inProgress %>)"></div>
                                <div class="progressBar needFix"
                                    style="width: <%= allTaskCount > 0 ? (statusCounts.fix / allTaskCount) * 100 : 0 %>%;"
                                    title="Need Fix (<%= statusCounts.fix %>)"></div>
                                <div class="progressBar completed"
                                    style="width: <%= allTaskCount > 0 ? (statusCounts.finished / allTaskCount) * 100 : 0 %>%;"
                                    title="Completed (<%= statusCounts.finished %>)"></div>
                            </div>
                            <div class="progressLegend">
                                <% if (statusCounts.pending > 0) { %>
                                    <span class="legendItem toDo">● รอตรวจ (<%= statusCounts.pending %>)</span>
                                <% } %>
                                <% if (statusCounts.inProgress > 0) { %>
                                    <span class="legendItem inProgress">● กำลังทำ (<%= statusCounts.inProgress %>)</span>
                                <% } %>
                                <% if (statusCounts.fix > 0) { %>
                                    <span class="legendItem needFix">● แก้ไข (<%= statusCounts.fix %>)</span>
                                <% } %>
                                <% if (statusCounts.finished > 0) { %>
                                    <span class="legendItem completed">● เสร็จสิ้น (<%= statusCounts.finished %>)</span>
                                <% } %>
                            </div>
                        </div> 
                        
                        <div class="countSec">
                            <div class="countTextWrap clickable-task-section" id="completedTask" data-task-type="completed">
                                <div class="countText">
                                    <span id="count">
                                        <%= completedCount %>
                                    </span> งาน
                                </div>
                                
                                <span id="subText">
                                    <i class="fa-solid fa-check" style="color: #57D9A3;"></i>
                                    ที่เสร็จสิ้น
                                </span>
                            </div>
                            <div class="countTextWrap clickable-task-section" id="incompletedTask" data-task-type="incompleted">
                                <div class="countText">
                                    <span id="count">
                                        <%= incompletedCount %>
                                    </span> งาน
                                </div>
                                
                                <span id="subText">
                                    <i class="fa-regular fa-clock" style="color: #ffab00;"></i>
                                    ที่เหลืออยู่
                                </span>
                            </div>
                        </div>
                    </div>  
                
                    <div class="attention">
                        <div class="headerText">
                            <div class="titleCardText">
                                <i class='bx bx-error-circle titleIcon' style="font-size: 24px;"></i>
                                งานที่ต้องการความใส่ใจ
                            </div>
                            <div class="subText">
                                งานที่รอการดำเนินการ
                            </div>
                        </div>
                        <div class="taskList">
                            <% pendingTasks.forEach(task => { %>
                                <div class="taskItem">
                                    <span class="attendIcon">
                                        <i class='bx bx-error-circle' 
                                            style="color: <%= task.taskPriority === 'urgent' && task.taskStatus === 'pending' ? '#ef4444' : '#f59e0b' %>;"></i>
                                    </span>
                                    <div class="taskDetail">
                                        <span id="attendName"><%= task.taskName %></span>
                                        <span id="attendItem">
                                            <% if (task.taskPriority === 'urgent') { %>
                                                <div id="attenPri">
                                                    <i class="fa-solid fa-flag"></i>
                                                    ด่วน
                                                </div>
                                            <% } %>
                                            <% if (task.taskStatus === 'pending') { %>
                                                <div id="attenStatus">
                                                    <i class="fa-solid fa-hourglass-half"></i>
                                                    รอตรวจ
                                                </div>
                                            <% } %>
                                        </span>
                                        <!-- Display Due Date or "No Due Date" -->
                                        <% if (task.dueDate) { 
                                            const dueDate = dayjs(task.dueDate); 
                                            const today = dayjs();
                                            const daysRemaining = dueDate.diff(today, 'day');
                                            const isDueSoon = daysRemaining <= 3; %>
                                            
                                            <div id="attenDueDate" style="color: <%= isDueSoon ? 'red' : 'inherit' %>;">
                                                <i class="fa-solid fa-calendar-day"></i>
                                                <%= dueDate.format('D MMMM YYYY') %>
                                            </div>
                                        <% } else { %>
                                            <div id="attenDueDate">
                                                <i class="fa-solid fa-calendar-day"></i>
                                                ไม่มีวันครบกำหนด
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                        <div class="viewTask">
                            <button id="viewBtn">ดูงานทั้งหมด <i class="fa-solid fa-arrow-up"></i></button>
                        </div>
                    </div>                                       
                </div>

                <div class="leftBottom">
                    <div class="title">
                       <div class="selectProjectDisplay">
                            <div class="selectItem" id="allProject" style="font-size: 22px;">
                                โปรเจกต์ทั้งหมด
                            </div>
                       </div>
                       <div class="createBtn">
                            <a href="/project" id="createBtn"> <i class="fa-solid fa-location-arrow"></i> ดูโปรเจกต์ทั้งหมด</a>
                       </div>
                    </div>
                    
                    <div class="projectContainer">
                        <% spaces.forEach(space => { %>
                            <div class="projectItemContainer">
                                <div class="projectItem" data-link="/space/item/<%= space._id %>/dashboard?period=7day">
                                    <div class="cover">
                                        <img src="<%= space.projectCover %>" alt="projectCover" id="projectCover">
                                    </div>
                                    <span id="projectName"><%= space.projectName || 'Unnamed Project' %></span>

                                    <div class="projectDetail">
                                        <div class="projectDetailText">
                                            <%= space.projectDetail || 'ไม่มีรายละเอียดเพิ่มเติม'%>
                                        </div>
                        
                                        <div class="detailInfo">
                                            <div class="createDate">
                                                <i class="fa-regular fa-calendar titleIcon"></i>
                                                <span><%= dayjs(space.createdAt).format('D MMMM YYYY') %></span>
                                            </div>
                                            <div class="member">
                                                <i class="fa-solid fa-user-group"></i>
                                                <span><%= space.collaborators.length %> คน </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="projectProgressBarContainer">
                                        <div class="progressBarWrap">
                                            <div class="projectProgressBar" id="projectTaskProgress">
                                                <div class="projectProgressBar toDo"
                                                    style="width: <%= space.projectAllTaskCount > 0 ? (space.statusCounts.toDo / space.projectAllTaskCount) * 100 : 0 %>%;"
                                                    title="To Do (<%= space.statusCounts.toDo %>)"></div>
                                                <div class="projectProgressBar inProgress"
                                                    style="width: <%= space.projectAllTaskCount > 0 ? (space.statusCounts.inProgress / space.projectAllTaskCount) * 100 : 0 %>%;"
                                                    title="In Progress (<%= space.statusCounts.inProgress %>)"></div>
                                                <div class="projectProgressBar needFix"
                                                    style="width: <%= space.projectAllTaskCount > 0 ? (space.statusCounts.fix / space.projectAllTaskCount) * 100 : 0 %>%;"
                                                    title="Need Fix (<%= space.statusCounts.fix %>)"></div>
                                                <div class="projectProgressBar completed"
                                                    style="width: <%= space.projectAllTaskCount > 0 ? (space.statusCounts.finished / space.projectAllTaskCount) * 100 : 0 %>%;"
                                                    title="Completed (<%= space.statusCounts.finished %>)"></div>
                                            </div>
                                        </div>
                                        
                                        <div class="projectProgressLegend">
                                            <span class="projectLegendItem toDo">● ยังไม่ทำ (<%= space.statusCounts.toDo || 0 %>)</span>
                                            <span class="projectLegendItem inProgress">● กำลังทำ (<%= space.statusCounts.inProgress || 0 %>)</span>
                                            <span class="projectLegendItem needFix">● แก้ไข (<%= space.statusCounts.fix || 0 %>)</span>
                                            <span class="projectLegendItem completed">● เสร็จสิ้น (<%= space.statusCounts.finished || 0 %>)</span>
                                        </div>
                                    </div>

                                    <div class="allCount">
                                        <div class="numberCount">
                                            งานที่มี <%= space.totalTasks %> งาน
                                        </div>
                                        <div class="completePercent">
                                            <%= space.completePercent %>% ที่เสร็จสิ้น
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                        <div class="projectItemContainer">
                            <a href="/createProject" id="mainCreateBtn"> 
                                <span>
                                    <i class="fa-solid fa-plus"></i> 
                                </span>
                                สร้างโปรเจกต์ใหม่
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="rightSide">
                <div class="headerText">
                    <div class="titleCardText">
                        <i class='fa-regular fa-calendar titleIcon'></i>
                        กำหนดส่งงานที่กำลังจะมีขึ้น
                    </div>
                </div>
                <div class="calendaSection">
                    <div id="calendarItem"></div>
                </div>
                <div class="taskListItem">
                    <div class="taskListHeader">📅 งานที่ต้องส่งวันนี้</div>
                    <div class="taskListContent">
                    </div>
                </div>
            </div>
        </div>

        <div class="tasksModal modal" id="tasksModal">
            <div class="modal-content">
                <div class="topModal">
                    <div class="nameSearch">
                        <h2 id="modalTitle"></h2>
                        <div class="searchContainer" style="display: none;">
                            <i class='bx bx-search searchIcon'></i>
                            <input type="search" placeholder="ค้นหางาน..." id="searchInput" name="modalSearchInput">
                        </div>
                    </div>
                    <span class="close">&times;</span>
                </div>
                <table id="tasksTable">
                    <thead>
                        <tr>
                            <th>โปรเจกต์</th>
                            <th>ชื่องาน</th>
                            <th>
                                <div class="tableHead">
                                    <i class='bx bxs-detail'></i>
                                    รายละเอียด
                                </div>
                            </th>
                            <th>
                                <div class="tableHead">
                                    <i class="fa-solid fa-circle-arrow-right"></i>
                                    สถานะ
                                </div>
                            </th>
                            <th>
                                <div class="tableHead">
                                    <i class="fa-solid fa-flag"></i>
                                    ความสำคัญ
                                </div>
                            </th>
                            <th>
                                <div class="tableHead">
                                    <i class="fa-solid fa-calendar-check"></i>
                                    วันครบกำหนด
                                </div>
                            </th>
                            <th>
                                <div class="tableHead">
                                    <i class="fa-solid fa-user-tag"></i> ผู้รับผิดชอบ
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <div style="max-height: 400px; overflow-y: auto;">
                        <tbody id="tasksTableBody">
                        </tbody>
                    </div>
                </table>
            </div>
        </div>
    </div>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@5.10.1/main.min.js'></script>
    <script src="/script/mainDashboard/dashboardScript.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const tasksData = <%- JSON.stringify(tasksData) %>;
            const clickableSections = document.querySelectorAll('.clickable-task-section');
        
            // Get the modal elements
            const tasksModal = document.getElementById('tasksModal');
            const modalTitle = document.getElementById('modalTitle');
            const tasksTableBody = document.getElementById("tasksTable")?.getElementsByTagName("tbody")[0];
            const closeModal = document.querySelector('.close');
        
            // Close modal when clicking the X button
            closeModal.addEventListener('click', function() {
                tasksModal.style.display = 'none';
            });
        
            // Close modal when clicking outside of it
            window.addEventListener('click', function(event) {
                if (event.target === tasksModal) {
                    tasksModal.style.display = 'none';
                }
            });
        
            // Add click event listeners to each clickable section
            clickableSections.forEach(section => {
                section.addEventListener('click', function() {
                    const spaceId = this.getAttribute('data-space-id'); // Get the selected space ID
                    const taskType = this.getAttribute('data-task-type');
        
                    // Fetch tasks only for the selected space (filter by project)
                    const tasksData = JSON.parse(document.querySelector('script[data-tasks]').getAttribute('data-tasks'));
                    
                    // Fix: Added missing tasksData definition here (reused global tasksData)
                    let filteredTasks = [];
                    let title = '';
        
                    if (taskType === 'completed') {
                        filteredTasks = tasksData.filter(task => task.taskStatus === 'finished');
                        title = 'งานที่เสร็จสิ้น';
                    } else if (taskType === 'incompleted') {
                        filteredTasks = tasksData.filter(task => 
                            ['inProgress', 'pending', 'fix'].includes(task.taskStatus)
                        );
                        title = 'งานทั้งหมดที่เหลืออยู่ (งานที่กำลังทำ, รอตรวจ และแก้ไข)';
                    }
        
                    // Update modal title
                    modalTitle.textContent = title;
        
                    // Clear existing table rows
                    tasksTableBody.innerHTML = '';
        
                    function checkDueDateWarning(element, dueDate) {
                        const today = new Date();
                        today.setHours(0, 0, 0, 0); // Normalize today's time to midnight
                        const diffInTime = new Date(dueDate) - today;
                        const diffInDays = Math.floor(diffInTime / (1000 * 60 * 60 * 24));
        
                        if (diffInDays < 0) {
                            element.style.color = '#FF5733'; // Red for overdue tasks
                        } else if (diffInDays === 0) {
                            element.style.color = '#FF5733'; // Red for due today
                        } else if (diffInDays > 0 && diffInDays <= 3) {
                            element.style.color = '#FFA500'; // Orange for tasks due in 3 days or less
                        } else {
                            element.style.color = 'black'; // Black for tasks with due dates far away
                        }
                    }
        
                    // Add filtered tasks to the table
                    filteredTasks.forEach(task => {
                        const row = document.createElement('tr');
                        
                        // Ensure that each task has a unique task ID
                        row.setAttribute('data-task-id', task._id);
                        row.setAttribute('data-space-id', spaceId);
        
                        row.onclick = function () {
                            const taskId = this.getAttribute('data-task-id');
                            const spaceId = this.getAttribute('data-space-id');
                            if (taskId && spaceId) {
                                window.location.href = `/task/${taskId}/detail?spaceId=${spaceId}`;
                            } else {
                                alert('Invalid task or space ID');
                            }
                        };
        
                        row.classList.add('taskItem');
        
                        let statusDiv;
                        switch(task.taskStatus) {
                            case 'finished':
                                statusDiv = `<div class="status finished"> เสร็จสิ้น</div>`;
                                break;
                            case 'inProgress':
                                statusDiv = `<div class="status inProgress">กำลังทำ</div>`;
                                break;
                            case 'pending':
                                statusDiv = `<div class="status pending">รอตรวจ</div>`;
                                break;
                            case 'fix':
                                statusDiv = `<div class="status fix">แก้ไข</div>`;
                                break;
                            default:
                                statusDiv = `<div class="status">${task.taskStatus}</div>`;
                        }
        
                        let priorityDiv;
                        switch(task.taskPriority) {
                            case 'urgent':
                                priorityDiv = `<div class="priority urgent"><i class="fa-solid fa-angles-up"></i> ด่วน</div>`;
                                break;
                            case 'normal':
                                priorityDiv = `<div class="priority normal"><i class="fa-solid fa-grip-lines"></i> ปกติ</div>`;
                                break;
                            case 'low':
                                priorityDiv = `<div class="priority low"><i class="fa-solid fa-angle-down"></i> ต่ำ</div>`;
                                break;
                            default:
                                priorityDiv = `<div class="priority">${task.taskPriority}</div>`;
                        }
        
                        function formatThaiDate(date) {
                            if (!date) return '';
                            const options = { day: 'numeric', month: 'short', year: 'numeric' };
                            return date.toLocaleDateString('th-TH', options);
                        }
        
                        row.innerHTML = `
                            <td id="taskNameModal">${task.taskName}</td>
                            <td id="detailModal">${task.taskDetail ? task.taskDetail : '<div class="nullValue">ไม่มีคำอธิบายเพิ่มเติม</div>'}</td>
                            <td id="statusModal">${statusDiv}</td>
                            <td id="priorityModal">${priorityDiv}</td>
                            <td id="dueDateModal">
                                ${task.dueDate ? formatThaiDate(new Date(task.dueDate)) : '<div class="nullValue">ไม่มีวันครบกำหนด</div>'}
                            </td>
                            <td id="createAtModal">${formatThaiDate(new Date(task.createdAt))}</td>
                            <td id="profileModal">
                                ${task.assignedUsers && task.assignedUsers.length > 0 
                                    ? task.assignedUsers
                                        .map(user => `
                                            <div class="profile-wrapper">
                                                <img src="${user.profileImage || '/public/img/profileImage/userDefalt.jpg'}" class="proImg" title="${user.username}"
                                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                <div class="fallback-profile-modal" style="display: none;">
                                                    <span>${user.firstName ? user.firstName[0] : ''}</span>
                                                </div>
                                            </div>
                                        `)
                                        .join('')
                                    : '<div class=nullValue>ไม่มีผู้รับมอบหมาย</div>'
                                }
                            </td>
                        `;
                        const dueDateElement = row.querySelector('#dueDateModal');
                        if (task.dueDate) {
                            checkDueDateWarning(dueDateElement, task.dueDate);
                        }
        
                        tasksTableBody.appendChild(row);
                    });
        
                    // Show the modal
                    tasksModal.style.display = 'block';
                });
            });
        
            // Add a script element to store the tasks data (if not already present)
            if (!document.querySelector('script[data-tasks]')) {
                const tasksScript = document.createElement('script');
                tasksScript.setAttribute('type', 'application/json');
                tasksScript.setAttribute('data-tasks', JSON.stringify(<%- JSON.stringify(tasksData) %>));
                document.body.appendChild(tasksScript);
            }
        });
        
        document.addEventListener("DOMContentLoaded", function () {
            // Get the modal and the button that opens it
            const viewBtn = document.getElementById("viewBtn");
            const tasksModal = document.getElementById("tasksModal");
            const closeModal = document.getElementById("closeModal");
            const tableBody = document.getElementById("tasksTableBody");

            // Get the task data from the server (assuming it is passed to the page)
            const pendingTasks = <%- JSON.stringify(pendingTasks) %>; // EJS variable holding the pending tasks
        
            // Format status and priority
            function formatStatus(taskStatus) {
                let statusDiv;
                switch(taskStatus) {
                    case 'finished':
                        statusDiv = `<div class="status finished">เสร็จสิ้น</div>`;
                        break;
                    case 'inProgress':
                        statusDiv = `<div class="status inProgress">กำลังทำ</div>`;
                        break;
                    case 'pending':
                        statusDiv = `<div class="status pending">รอตรวจ</div>`;
                        break;
                    case 'fix':
                        statusDiv = `<div class="status fix">แก้ไข</div>`;
                        break;
                    default:
                        statusDiv = `<div class="status">${taskStatus}</div>`;
                }
                return statusDiv;
            }

            function formatPriority(taskPriority) {
                let priorityDiv;
                switch(taskPriority) {
                    case 'urgent':
                        priorityDiv = `<div class="priority urgent"><i class="fa-solid fa-angles-up"></i> ด่วน</div>`;
                        break;
                    case 'normal':
                        priorityDiv = `<div class="priority normal"><i class="fa-solid fa-grip-lines"></i> ปกติ</div>`;
                        break;
                    case 'low':
                        priorityDiv = `<div class="priority low"><i class="fa-solid fa-angle-down"></i> ต่ำ</div>`;
                        break;
                    default:
                        priorityDiv = `<div class="priority">${taskPriority}</div>`;
                }
                return priorityDiv;
            }

            function formatThaiDate(date) {
                if (!date) return '';
                const options = { day: 'numeric', month: 'short', year: 'numeric' };
                return date.toLocaleDateString('th-TH', options);
            }
        
            function populateTasksModal(tasks) {
                tableBody.innerHTML = ''; // Clear previous content
            
                tasks.forEach(task => {
                    // Create a new row
                    const row = document.createElement("tr");
                    row.classList.add("taskItem");
            
                    // Project Name (New Column)
                    const projectName = document.createElement("td");
                    projectName.id = "projectNameModal";
                    projectName.innerHTML = task.projectName; // Display project name
            
                    // Task Name
                    const taskName = document.createElement("td");
                    taskName.id = "taskNameModal";
                    taskName.innerHTML = task.taskName;
            
                    // Task Detail
                    const taskDetail = document.createElement("td");
                    taskDetail.id = "detailModal";
                    taskDetail.innerHTML = task.taskDetail ? task.taskDetail : '<div class="nullValue">ไม่มีคำอธิบายเพิ่มเติม</div>';
            
                    // Task Status
                    const statusDiv = formatStatus(task.taskStatus); 
                    const taskStatus = document.createElement("td");
                    taskStatus.id = "statusModal";
                    taskStatus.innerHTML = statusDiv;
            
                    // Task Priority
                    const priorityDiv = formatPriority(task.taskPriority); 
                    const taskPriority = document.createElement("td");
                    taskPriority.id = "priorityModal";
                    taskPriority.innerHTML = priorityDiv;
            
                    // Due Date
                    const taskDueDate = document.createElement("td");
                    taskDueDate.id = "dueDateModal";
                    taskDueDate.innerHTML = task.dueDate ? formatThaiDate(new Date(task.dueDate)) : '<div class="nullValue">ไม่มีวันครบกำหนด</div>';
            
                    // Assigned Users (Profile)
                    const assignedUsers = document.createElement("td");
                    assignedUsers.id = "profileModal";
                    assignedUsers.innerHTML = task.assignedUsers && task.assignedUsers.length > 0
                        ? task.assignedUsers
                            .map(user => `
                                <div class="profile-wrapper">
                                    <img src="${user.profileImage || '/public/img/profileImage/userDefalt.jpg'}" class="proImg" title="${user.username}"
                                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                    <div class="fallback-profile-modal" style="display: none;">
                                        <span>${user.firstName ? user.firstName[0] : ''}</span>
                                    </div>
                                </div>
                            `)
                            .join('')
                        : '<div class="nullValue">ไม่มีผู้รับมอบหมาย</div>';
            
                    // Append all cells to the row
                    row.appendChild(projectName); // Append project name first
                    row.appendChild(taskName);
                    row.appendChild(taskDetail);
                    row.appendChild(taskStatus);
                    row.appendChild(taskPriority);
                    row.appendChild(taskDueDate);
                    row.appendChild(assignedUsers);
            
                    // Append the row to the table body
                    tableBody.appendChild(row);
                });
            }            
        
            // Show modal when clicking the button
            viewBtn.onclick = function () {
                populateTasksModal(pendingTasks); // Use the sorted pendingTasks passed from the backend
                tasksModal.style.display = "block";
            };
        
            // Close the modal when clicking the close button
            closeModal.onclick = function () {
                tasksModal.style.display = "none";
            };
        
            // Close the modal if clicked outside of it
            window.onclick = function (event) {
                if (event.target === tasksModal) {
                    tasksModal.style.display = "none";
                }
            };
        });
        
        
    </script>
</body>
</html>